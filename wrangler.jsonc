{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crm-by-mac",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/.netlify/functions/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ]
}
